# ==============================================================================
# AlfaazStudio - Environment Configuration Template
# Copy this file to .env and adjust variables as required
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_NAME=AlfaazStudio
APP_VERSION=0.1.0

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Compute Device (auto, cuda, cpu)
DEVICE=auto
CUDA_VISIBLE_DEVICES=0
TORCH_NUM_THREADS=4

# Storage Directories
MODEL_DIR=./models
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# Speech Synthesis Engine Settings (f5-tts, melotts, mock)
DEFAULT_TTS_ENGINE=f5-tts
FALLBACK_TTS_ENGINE=mock
SAMPLE_RATE=24000

# Audio Post-Processing Presets
DEFAULT_REVERB_ROOM_SIZE=0.35
DEFAULT_REVERB_DAMPING=0.5
DEFAULT_EQ_WARMTH_DB=2.5
DEFAULT_BGM_DUCKING_DB=-12.0

# Video & Subtitle Rendering
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_CRF=20
FFMPEG_PRESET=medium
DEFAULT_FONT_NAME=Jameel Noori Nastaleeq
FALLBACK_FONT_NAME=Noto Nastaliq Urdu

# Logging & Concurrency
LOG_LEVEL=INFO
MAX_CONCURRENT_RENDERS=2
TEMP_RETENTION_HOURS=24

